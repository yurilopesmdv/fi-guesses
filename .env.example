# App (públicas por desenho — a proteção é o RLS do Supabase)
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Monitor Ao vivo: manter false sem assinatura OpenF1 validada.
# Alterar requer novo bundle (dev: reiniciar Expo; distribuído: publicar JS/web).
EXPO_PUBLIC_LIVE_ENABLED=false

# Operação local (scripts/). Nunca commitar. No CI viram secrets do GitHub.
SUPABASE_ACCESS_TOKEN=   # supabase.com/dashboard/account/tokens — roda migrations e deploy da função
EXPO_TOKEN=              # expo.dev → Access tokens — publica o app (EAS Update/Hosting/Build)
